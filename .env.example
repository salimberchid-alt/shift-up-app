# shift-up.app environment
#
# Copy to .env.local for local work; set the same names in the Vercel project
# for preview and production. Everything below is optional: the site builds
# and runs with none of it, and each integration stays inert until its key
# appears.

# --- Supabase (already in use) -------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Advertising measurement ---------------------------------------------
# Without these, no pixel loads, no consent banner appears, and the
# Conversions API route returns 204. Adding them is what switches tracking on.

# Meta Events Manager > Data sources > your pixel > Settings. Public: it ends
# up in the browser bundle, which is normal for a pixel id.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement id, format G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Conversions API system-user token, from Events Manager > Settings >
# Generate access token. SERVER ONLY, never prefix this with NEXT_PUBLIC_:
# it can write conversions into the ad account.
META_CAPI_ACCESS_TOKEN=

# Only if Events Manager shows a dataset id different from the pixel id.
# Defaults to NEXT_PUBLIC_META_PIXEL_ID.
META_DATASET_ID=

# Set while verifying in Events Manager > Test events, then REMOVE it.
# Events sent with a test code do not count toward optimisation.
META_CAPI_TEST_EVENT_CODE=

# Graph API version for the Conversions API. Defaults to v25.0, which Meta
# supports until July 2028. Bump when that date gets close.
META_GRAPH_API_VERSION=

# RESEND_API_KEY is intentionally gone. It powered src/app/api/waitlist,
# a route nothing ever called; the live form uses Supabase magic links.
